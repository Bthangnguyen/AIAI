PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Postgres (matches docker-compose.yml defaults)
SQL_HOST=db
SQL_PORT=5432
SQL_DB=travel
SQL_USER=travel
SQL_PASSWORD=travel_secret

DB_POOL_MIN_SIZE=20
DB_POOL_MAX_SIZE=100
DB_POOL_TIMEOUT=10

# Layer 4 Solver (Docker Gateway → host Solver on Windows)
LAYER4_BASE_URL=http://host.docker.internal:8000

# LLM — fill ONE provider key before running live tests
LLM_PROVIDER=shopaikey
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-chat
OPENROUTER_LLM_MODEL=deepseek/deepseek-v4-flash
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

RATE_LIMIT_PER_MINUTE=5

# Admin POI API (local dev — disable in production)
ADMIN_ENABLED=true
ADMIN_TOKEN=
