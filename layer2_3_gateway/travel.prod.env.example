PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=60
DB_POOL_TIMEOUT=10

RATE_LIMIT_PER_MINUTE=20

# Disable admin endpoints in production unless you intentionally expose them.
ADMIN_ENABLED=false
ADMIN_TOKEN=

# LLM provider. Prefer ShopAPIKey first and fall back to OpenRouter.
LLM_PROVIDER=shopaikey
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-chat
OPENROUTER_LLM_MODEL=deepseek/deepseek-v4-flash
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Optional Firebase Admin auth.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
